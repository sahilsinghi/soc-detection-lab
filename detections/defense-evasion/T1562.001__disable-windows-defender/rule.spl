index=soc-lab sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational"
EventCode=1
(CommandLine="*Set-MpPreference*Disable*"
  OR CommandLine="*sc*stop*WinDefend*"
  OR CommandLine="*Add-MpPreference*ExclusionPath*")
| eval mitre_technique="T1562.001", mitre_tactic="Defense Evasion", severity="high"
| table _time, host, User, ParentImage, CommandLine, mitre_technique, severity
| sort -_time
