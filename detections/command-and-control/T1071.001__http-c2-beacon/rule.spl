index=main sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
EventCode=3
NOT (Image IN ("*\\chrome.exe","*\\firefox.exe","*\\msedge.exe","*\\svchost.exe","*\\MsMpEng.exe"))
DestinationPort IN (80, 443, 8080, 8443)
| bucket _time span=1m
| stats count by _time, host, Image, DestinationIp, DestinationPort
| where count > 5
| eval mitre_technique="T1071.001", mitre_tactic="Command and Control", severity="medium"
| sort -_time
